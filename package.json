{
  "name": "webhid-ds4",
  "version": "1.0.5",
  "description": "An API wrapper built over the experimental WebHID API to communicate with DualShock 4 controllers",
  "main": "dist/webhid-ds4.js",
  "module": "dist/webhid-ds4.esm.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBITLINK/WebHID-DS4.git"
  },
  "author": "TheBITLINK aka BIT <me@thebitlink.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rolldown -c && tsc --emitDeclarationOnly",
    "build-docs": "parcel build --target demo --no-autoinstall && typedoc",
    "prepack": "node --run build",
    "test": "node --run build && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@parcel/transformer-vue": "^2.16.4",
    "@types/w3c-web-hid": "^1.0.7",
    "@vue/compiler-sfc": "^3.5.42",
    "parcel": "^2.16.4",
    "rolldown": "^1.2.7",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vue": "^3.5.42"
  },
  "browserslist": [
    "last 1 Chrome version"
  ],
  "targets": {
    "demo": {
      "source": "demo/index.html",
      "context": "browser",
      "distDir": "dist-pages",
      "publicUrl": "./"
    }
  }
}
